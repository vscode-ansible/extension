{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ansible",
  "scopeName": "source.ansible",
  "patterns": [
    { "include": "#comment" },
    { "include": "#jinja" },
    { "include": "#yaml" },
    { "include": "#ansible" }
  ],
  "repository": {
    "comment": {
      "match": "^[ \\t]*#.*$",
      "name": "comment.line.number-sign.ansible"
    },
    "jinja": {
      "patterns": [
        {
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "name": "string.template.jinja.ansible",
          "beginCaptures": { "0": { "name": "punctuation.definition.variable.begin.ansible" } },
          "endCaptures": { "0": { "name": "punctuation.definition.variable.end.ansible" } },
          "patterns": [
            {
              "match": "\\|[a-zA-Z_][a-zA-Z0-9_]*",
              "name": "support.function.filter.jinja"
            },
            {
              "match": "\\b(?:true|false|True|False|none|None|yes|no)\\b",
              "name": "constant.language.boolean.ansible"
            },
            {
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\.|\\[|\\s*\\|)",
              "name": "variable.other.jinja.ansible"
            }
          ]
        },
        {
          "begin": "\\{%",
          "end": "%\\}",
          "name": "meta.statement.jinja.ansible",
          "beginCaptures": { "0": { "name": "punctuation.definition.statement.begin.ansible" } },
          "endCaptures": { "0": { "name": "punctuation.definition.statement.end.ansible" } },
          "patterns": [
            {
              "match": "\\b(?:for|if|else|elif|endif|endfor|set|include|import|extends|block|macro|with|namespace|do|filter)\\b",
              "name": "keyword.control.jinja.ansible"
            }
          ]
        }
      ]
    },
    "yaml": {
      "patterns": [
        {
          "match": "^[ \\t]*(?:-\\s+)?([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s*:)",
          "captures": { "1": { "name": "entity.name.tag.ansible" } }
        },
        {
          "match": ":[ \\t]+(?:\"([^\"]*)\"|'([^']*)')",
          "captures": {
            "1": { "name": "string.quoted.double.ansible" },
            "2": { "name": "string.quoted.single.ansible" }
          }
        },
        {
          "match": ":[ \\t]+(?=[^\\s#])[^\\s#]*",
          "captures": { "0": { "name": "string.unquoted.ansible" } }
        },
        {
          "match": "\\b(?:true|false|yes|no|on|off)\\b",
          "name": "constant.language.boolean.ansible"
        },
        {
          "match": "\\b(?:null|none|~)\\b",
          "name": "constant.language.null.ansible"
        },
        {
          "match": "\\b-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?\\b",
          "name": "constant.numeric.ansible"
        },
        {
          "match": "\\{\\{\\s*[a-zA-Z_][a-zA-Z0-9_.]*\\s*\\}\\}",
          "name": "variable.other.ansible"
        }
      ]
    },
    "ansible": {
      "patterns": [
        {
          "match": "^[ \\t]*-\\s+(?:ansible\\.builtin\\.)?(apt|yum|dnf|pip|shell|command|copy|template|file|service|systemd|user|group|lineinfile|blockinfile|replace|git|unarchive|get_url|uri|assert|fail|debug|set_fact|include_tasks|import_tasks|include_role|import_role|wait_for|pause|stat|find|cron|hostname|mount|firewalld|selinux|docker_container|docker_image)\\s*:",
          "captures": { "1": { "name": "entity.name.function.ansible" } }
        },
        {
          "match": "\\b(?:ansible\\.builtin\\.)?(apt|yum|dnf|pip|shell|command|copy|template|file|service|systemd|user|group|lineinfile|blockinfile|replace|git|unarchive|get_url|uri|assert|fail|debug|set_fact|include_tasks|import_tasks|include_role|import_role|wait_for|pause|stat|find|cron|hostname|mount|firewalld|selinux|docker_container|docker_image)\\b",
          "name": "entity.name.function.ansible"
        },
        {
          "match": "\\b(?:hosts|tasks|handlers|roles|vars|vars_files|become|become_user|become_method|gather_facts|connection|strategy|serial|tags|pre_tasks|post_tasks|ignore_errors|when|loop|with_items|notify|delegate_to|run_once|register|changed_when|failed_when|until|retries|delay|environment|collections|module_defaults)\\b",
          "name": "keyword.other.ansible"
        },
        {
          "match": "\\b(?:ansible_facts|ansible_host|ansible_user|ansible_connection|inventory_hostname|groups|hostvars|playbook_dir|role_path)\\b",
          "name": "variable.language.ansible"
        },
        {
          "match": "\\b(?:name|state|mode|owner|group|enabled|present|absent|restarted|started|stopped|latest)\\b",
          "name": "constant.other.ansible"
        }
      ]
    }
  }
}
