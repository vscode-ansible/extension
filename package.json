{
  "name": "vscode-ansible-extension",
  "displayName": "VSCode Ansible Extension",
  "description": "Ansible support for VS Code: syntax highlighting, module autocomplete, playbook runner, linting, project graphs, secret detection, and debugging.",
  "version": "0.1.7",
  "publisher": "vscode-ansible",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "ansible",
    "yaml",
    "playbook",
    "devops",
    "devsecops"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:ansible",
    "onView:ansibleToolkit.explorer",
    "onCommand:ansibleToolkit.runPlaybook",
    "onCommand:ansibleToolkit.showGraph",
    "onCommand:ansibleToolkit.runLint",
    "onCommand:ansibleToolkit.listTasks",
    "onCommand:ansibleToolkit.runFromTask",
    "onCommand:ansibleToolkit.detectSecrets",
    "onCommand:ansibleToolkit.runQueue",
    "onCommand:ansibleToolkit.showModules",
    "onCommand:ansibleToolkit.refreshExplorer",
    "onCommand:ansibleToolkit.openForm",
    "onCommand:ansibleToolkit.openSteps"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ansible",
        "aliases": [
          "Ansible",
          "ansible"
        ],
        "extensions": [
          ".yml",
          ".yaml"
        ],
        "filenamePatterns": [
          "**/playbooks/*.yml",
          "**/playbooks/*.yaml",
          "**/*playbook*.yml",
          "**/*playbook*.yaml",
          "**/roles/**/main.yml",
          "**/roles/**/main.yaml",
          "**/tasks/**/*.yml",
          "**/tasks/**/*.yaml",
          "**/handlers/**/*.yml",
          "**/handlers/**/*.yaml",
          "**/defaults/**/*.yml",
          "**/defaults/**/*.yaml",
          "**/vars/**/*.yml",
          "**/vars/**/*.yaml",
          "**/meta/*.yml",
          "**/meta/*.yaml",
          "**/host_vars/**/*.yml",
          "**/host_vars/**/*.yaml",
          "**/group_vars/**/*.yml",
          "**/group_vars/**/*.yaml",
          "**/molecule/*/molecule.yml",
          "**/molecule/*/molecule.yaml"
        ],
        "filenames": [
          "ansible.cfg",
          "site.yml",
          "site.yaml",
          "galaxy.yml",
          "galaxy.yaml",
          "execution-environment.yml",
          "execution-environment.yaml",
          "requirements.yml",
          "requirements.yaml"
        ],
        "firstLine": "# code: language=ansible",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ansible",
        "scopeName": "source.ansible",
        "path": "./syntaxes/ansible.tmLanguage.json"
      },
      {
        "scopeName": "source.ansible.jinja",
        "path": "./syntaxes/jinja.tmLanguage.json",
        "injectTo": [
          "source.ansible",
          "source.yaml"
        ]
      }
    ],
    "iconThemes": [
      {
        "id": "ansible-icons",
        "label": "Ansible Icons",
        "path": "./fileicons/ansible-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ansibleToolkit",
          "title": "Ansible",
          "icon": "icons/ansible-sidebar.svg"
        }
      ]
    },
    "views": {
      "ansibleToolkit": [
        {
          "id": "ansibleToolkit.explorer",
          "name": "Project",
          "contextualTitle": "Ansible"
        }
      ]
    },
    "configuration": {
      "title": "Ansible Toolkit",
      "properties": {
        "ansibleToolkit.ansiblePlaybookPath": {
          "type": "string",
          "default": "ansible-playbook",
          "description": "Path to the ansible-playbook executable (or a name on PATH)."
        },
        "ansibleToolkit.ansibleLintPath": {
          "type": "string",
          "default": "ansible-lint",
          "description": "Path to the ansible-lint executable (or a name on PATH)."
        },
        "ansibleToolkit.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ansible-lint diagnostics."
        },
        "ansibleToolkit.lint.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Run ansible-lint automatically after saving a file."
        },
        "ansibleToolkit.secrets.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Scan playbooks and vars for secrets in plain text."
        },
        "ansibleToolkit.defaultInventory": {
          "type": "string",
          "default": "",
          "description": "Default inventory (e.g. inventory/hosts.yml)."
        }
      }
    },
    "configurationDefaults": {
      "[ansible]": {
        "editor.autoIndent": "advanced",
        "editor.detectIndentation": true,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
          "comments": true,
          "other": true,
          "strings": true
        },
        "editor.tabSize": 2
      }
    },
    "yamlValidation": [
      {
        "fileMatch": [
          "execution-environment.yml",
          "execution-environment.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/execution-environment.json"
      },
      {
        "fileMatch": [
          "meta/runtime.yml",
          "meta/runtime.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/meta-runtime.json"
      },
      {
        "fileMatch": [
          ".ansible-navigator.yaml",
          ".ansible-navigator.yml",
          "ansible-navigator.yaml",
          "ansible-navigator.yml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-navigator/main/src/ansible_navigator/data/ansible-navigator.json"
      },
      {
        "fileMatch": [
          "requirements.yml",
          "requirements.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/requirements.json"
      },
      {
        "fileMatch": [
          "meta/main.yml",
          "meta/main.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/meta.json"
      },
      {
        "fileMatch": [
          "tasks/**/*.yml",
          "tasks/**/*.yaml",
          "handlers/**/*.yml",
          "handlers/**/*.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/tasks.json"
      },
      {
        "fileMatch": [
          "playbooks/vars/*.yml",
          "playbooks/vars/*.yaml",
          "vars/*.yml",
          "vars/*.yaml",
          "defaults/*.yml",
          "defaults/*.yaml",
          "host_vars/*.yml",
          "host_vars/*.yaml",
          "group_vars/*.yml",
          "group_vars/*.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/vars.json"
      },
      {
        "fileMatch": [
          ".ansible-lint",
          ".config/ansible-lint.yml",
          ".config/ansible-lint.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible-lint-config.json"
      },
      {
        "fileMatch": [
          "molecule/*/molecule.yml",
          "molecule/*/molecule.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible-community/molecule/main/src/molecule/data/molecule.json"
      },
      {
        "fileMatch": [
          "galaxy.yml",
          "galaxy.yaml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/galaxy.json"
      },
      {
        "fileMatch": [
          "rulebooks/*.yaml",
          "rulebooks/*.yml"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-rulebook/main/ansible_rulebook/schema/ruleset_schema.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".ansible-navigator.json",
          "ansible-navigator.json"
        ],
        "url": "https://raw.githubusercontent.com/ansible/ansible-navigator/main/src/ansible_navigator/data/ansible-navigator.json"
      }
    ],
    "commands": [
      {
        "command": "ansibleToolkit.runPlaybook",
        "title": "Ansible: Run playbook",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.runLint",
        "title": "Ansible: Run ansible-lint",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.showGraph",
        "title": "Ansible: Show project graph",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.listTasks",
        "title": "Ansible: List playbook tasks",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.runFromTask",
        "title": "Ansible: Run from task",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.detectSecrets",
        "title": "Ansible: Find secrets in project",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.runQueue",
        "title": "Ansible: Run playbooks in sequence (queue)",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.showModules",
        "title": "Ansible: Show modules reference",
        "category": "Ansible Toolkit"
      },
      {
        "command": "ansibleToolkit.refreshExplorer",
        "title": "Ansible: Refresh project explorer",
        "category": "Ansible Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "ansibleToolkit.openForm",
        "title": "Ansible: Open playbook builder",
        "category": "Ansible Toolkit",
        "icon": "$(edit)"
      },
      {
        "command": "ansibleToolkit.openSteps",
        "title": "Ansible: Run tasks step by step",
        "category": "Ansible Toolkit",
        "icon": "$(debug-step-over)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ansibleToolkit.refreshExplorer",
          "when": "view == ansibleToolkit.explorer",
          "group": "navigation"
        },
        {
          "command": "ansibleToolkit.showGraph",
          "when": "view == ansibleToolkit.explorer",
          "group": "navigation"
        },
        {
          "command": "ansibleToolkit.showModules",
          "when": "view == ansibleToolkit.explorer",
          "group": "navigation"
        },
        {
          "command": "ansibleToolkit.openForm",
          "when": "view == ansibleToolkit.explorer",
          "group": "navigation"
        },
        {
          "command": "ansibleToolkit.openSteps",
          "when": "view == ansibleToolkit.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ansibleToolkit.runPlaybook",
          "when": "view == ansibleToolkit.explorer && viewItem == playbook",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "ansibleToolkit.runPlaybook",
          "when": "editorLangId == ansible || editorLangId == yaml",
          "group": "navigation@1"
        },
        {
          "command": "ansibleToolkit.openSteps",
          "when": "editorLangId == ansible || editorLangId == yaml",
          "group": "navigation@2"
        },
        {
          "command": "ansibleToolkit.openForm",
          "when": "editorLangId == ansible || editorLangId == yaml",
          "group": "navigation@3"
        },
        {
          "command": "ansibleToolkit.showModules",
          "when": "editorLangId == ansible || editorLangId == yaml",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "ansibleToolkit.runPlaybook",
          "when": "editorLangId == ansible || editorLangId == yaml"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ansibleToolkit.runPlaybook",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && (editorLangId == ansible || editorLangId == yaml)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "package": "vsce package"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
